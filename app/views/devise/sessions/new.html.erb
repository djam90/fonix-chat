<% content_for :title, "Sign in | Fonix Chat" %>

<section class="card">
  <h1>Sign in</h1>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "form" }) do |f| %>
    <%= f.label :email, "Email address" %>
    <%= f.email_field :email, required: true, autofocus: true, autocomplete: "email" %>

    <%= f.label :password %>
    <%= f.password_field :password, required: true, autocomplete: "current-password" %>

    <% if devise_mapping.rememberable? %>
      <label class="form__checkbox">
        <%= f.check_box :remember_me %> Remember me
      </label>
    <% end %>

    <%= f.submit "Sign in", class: "button" %>
  <% end %>

  <%= render "devise/shared/links" %>
</section>
