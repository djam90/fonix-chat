<% content_for :title, "Forgot password | Fonix Chat" %>

<section class="card">
  <h1>Forgot your password?</h1>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "form" }) do |f| %>
    <%= render "shared/form_errors", record: resource %>

    <%= f.label :email, "Email address" %>
    <%= f.email_field :email, required: true, autofocus: true, autocomplete: "email" %>

    <%= f.submit "Email reset instructions", class: "button" %>
  <% end %>

  <%= render "devise/shared/links" %>
</section>
